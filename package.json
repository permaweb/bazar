{
	"name": "bazar",
	"version": "2.0.0",
	"description": "A browser-only marketplace for Arweave-native assets",
	"private": true,
	"scripts": {
		"clean:install": "rm -rf node_modules package-lock.json || true && npm cache clean --force && npm install",
		"start": "vite",
		"start:development": "vite",
		"build": "tsc --noEmit && vite build",
		"build:production": "tsc --noEmit && vite build",
		"deploy:main": "npm run build && node scripts/deploy-site.mjs",
		"deploy:reference": "npm run build && node scripts/deploy-site.mjs && node scripts/site-reference.mjs set",
		"reference:init": "node scripts/site-reference.mjs init",
		"reference:set": "node scripts/site-reference.mjs set",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "eslint --fix . && npx prettier --write .",
		"prepare": "husky install",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@fontsource/dm-sans": "^5.3.0",
		"ao-wrangler": "file:vendor/ao-wrangler-0.1.15.tgz",
		"arweave": "^1.15.7",
		"lucide-react": "^1.28.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-router-dom": "^6.30.1",
		"styled-components": "^5.3.11",
		"three": "^0.185.1",
		"weave-wrangler": "file:vendor/weave-wrangler-0.1.0.tgz"
	},
	"devDependencies": {
		"@types/node": "^22.10.1",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@types/styled-components": "^5.1.34",
		"@types/three": "^0.180.0",
		"@typescript-eslint/eslint-plugin": "^6.0.0",
		"@typescript-eslint/parser": "^6.0.0",
		"@vitejs/plugin-react": "^4.4.1",
		"arbundles": "^0.11.2",
		"eslint": "^8.35.0",
		"eslint-plugin-import": "^2.27.5",
		"eslint-plugin-react-hooks": "^4.6.2",
		"eslint-plugin-simple-import-sort": "^10.0.0",
		"husky": "^8.0.0",
		"prettier": "^2.8.3",
		"typescript": "^5.7.2",
		"vite": "^6.4.1",
		"vite-plugin-node-polyfills": "^0.24.0",
		"vitest": "^3.2.4"
	}
}

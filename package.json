{
  "name": "bazar",
  "version": "2.0.0",
  "description": "A browser-only marketplace for Arweave-native assets",
  "private": true,
  "scripts": {
    "start": "vite",
    "start:development": "vite",
    "build": "tsc --noEmit && vite build",
    "build:production": "tsc --noEmit && vite build",
    "deploy:main": "npm run build && node scripts/deploy-site.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "arweave": "^1.15.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "styled-components": "^5.3.11",
    "three": "^0.185.1",
    "weave-wrangler": "file:vendor/weave-wrangler-0.1.0.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/styled-components": "^5.1.34",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.7.2",
    "vite": "^6.4.1",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vitest": "^3.2.4"
  }
}
